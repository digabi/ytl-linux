<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "https://specifications.freedesktop.org/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Matriculation Examination Board</vendor>
  <vendor_url>http://github.com/digabi/ytl-linux/</vendor_url>
  <action id="fi.ylioppilastutkinto.fi.ytl-linux-system-reset">
    <description>Support GUI authentication for installing YTL Linux software updates</description>
    <message>Authentication is required to reset the system. Please enter your password.</message>
    <message xml:lang="fi">Lupa tarvitaan järjestelmän nollausta varten. Syötä tietokoneen salasana.</message>
    <message xml:lang="sv">Tillstånd krävs för att nollställa systemet. Mata in datorns lösenord.</message>
    <defaults>
     <allow_any>no</allow_any>
     <allow_inactive>no</allow_inactive>
     <allow_active>auth_self_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/ytl-linux-system-reset</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
