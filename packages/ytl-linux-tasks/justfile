# This fallback is to allow `just deb` to work during development; the runner script in production uses the --ceiling parameter to use only this file
set fallback

[private]
default:
    @just --list --unsorted

# A group of tasks essential for every healthy YTL Linux installation.
[private]
maintenance: migrate-package-keys \
    remove-virtualbox \
    remove-systemd-timesyncd-and-update-manager \
    remove-virtualbox-source

# Same as maintenance, but executed as the school user
[private]
user-maintenance:

# Installs public keys of package sources to supported location
migrate-package-keys:
    './scripts/system/2026-02-18_migrate-package-keys.py'

# Remove VirtualBox 7.1 and its requirements (autopurge)
remove-virtualbox:
    './scripts/system/2026-04-16_remove-virtualbox.sh'

# Remove systemd-timesyncd and update-manager from existing installation
remove-systemd-timesyncd-and-update-manager:
    './scripts/system/2026-08-11_remove-systemd-timesyncd-and-update-manager.sh'

# Remove VirtualBox source if installed
remove-virtualbox-source:
    './scripts/system/2026-09-23_remove-virtualbox-source.sh'

# Creates a tarball of the Abitti 2 server database for e.g. troubleshooting or debugging
archive-digabi2-database:
    #!/usr/bin/env bash
    set -euo pipefail

    timestamp=$(date '+%Y-%m-%d-%H%M%S')
    archive_path="{{ invocation_directory() }}/digabi2-dbdata-${timestamp}.tar.gz"
    mountpoint=$(docker inspect digabi2_dbdata | jq -r '.[0].Mountpoint')
    sudo tar cvzf "${archive_path}" "${mountpoint%/*}"
    echo "Digabi2 database archive created: ${archive_path}"
    open "{{ invocation_directory() }}"

patch-server version:
    @naksu2 --cli patch-server {{ version }}

open-answers-backups:
    #!/usr/bin/env bash
    set -euo pipefail

    ANSWERS_BACKUPS_DIR="{{ data_local_directory() }}/digabi/naksu2/answers-backups"

    if [[ ! -d "$ANSWERS_BACKUPS_DIR" ]]; then
        # Ensure consistent behaviour even when there are no answers backups
        mkdir -p "$ANSWERS_BACKUPS_DIR"
    fi

    open "$ANSWERS_BACKUPS_DIR"
